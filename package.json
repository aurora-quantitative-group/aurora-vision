{
  "name": "aurora-matchmaker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.ts",
    "migrate": "node --env-file=.env scripts/migrate.ts",
    "setup:mongo": "node --env-file=.env scripts/setup-mongo.ts",
    "seed": "node --env-file=.env scripts/seed.ts",
    "verify": "node --env-file=.env scripts/verify.ts",
    "print-tools": "node src/agent/print.ts",
    "test": "node --env-file-if-exists=.env --test test/",
    "check": "tsc"
  },
  "dependencies": {
    "@google/genai": "3.3.0",
    "fastify": "5.12.8",
    "mongodb": "7.9.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
