#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if ! command -v node >/dev/null 2>&1; then
    PATH="$root/.local/node/bin:$PATH"
    export PATH
fi
if ! command -v node >/dev/null 2>&1; then
    echo "Install Node 24 from https://nodejs.org, then run this command again." >&2
    exit 1
fi
mkdir -p "$root/.local/chert"
CHERT_HOME="$root/.local/chert"
export CHERT_HOME
npm_config_cache="$root/.local/npm-cache"
export npm_config_cache
exec npx --yes --prefer-online @trychert/facetime@0.1.0-beta.21 "$@"
